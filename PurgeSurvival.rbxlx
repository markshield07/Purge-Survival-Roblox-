local NotifContainer = CreateFrame({
	Name = "Notifications",
	Size = UDim2.new(0, 400, 0, 300),
	Position = UDim2.new(0.5, 0, 0.7, 0),
	AnchorPoint = Vector2.new(0.5, 0),
