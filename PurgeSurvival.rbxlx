		description = "Thin plywood sheet. Won't hold long.",
		stackable = true,
		maxStack = 10,
		weight = 2,
	},
	duct_tape = {
		name = "Duct Tape",
		category = Cat.BuildingMaterial,
		tier = Tier.Common,
		description = "Fixes anything. Temporarily.",
		stackable = true,
		maxStack = 5,
