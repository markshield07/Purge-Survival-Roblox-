		"bulletproof_glass", "steel_panels",
		"lockpick",
	},
	GasStation = {
		"fuel_small", "fuel_medium", "fuel_large",
		"fuel_small", "fuel_medium",
		"crackers", "energy_drink", "bottled_water",
		"flashlight", "candle",
	},
	AbandonedSchool = {
		"plywood", "wooden_planks", "scrap_metal",
		"canned_beans", "crackers", "bottled_water",
		"stale_bread", "candle", "flashlight",
		"baseball_bat", "crowbar",
		"duct_tape", "nails",
		"recipe_heated_beans",
